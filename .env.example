# Example environment variables for local development and deployment
# Copy this file to .env and fill in production values (DO NOT commit secrets)

# AWS region
AWS_REGION=us-east-1

# S3 bucket for uploads and media
S3_BUCKET_NAME=my-app-content-bucket

# DynamoDB table used for content metadata
DYNAMODB_TABLE_NAME=content-table

# Bedrock / LLM settings
BEDROCK_MODEL_ID=example-bedrock-model-id
OUTPUT_PROVIDER=aws_only
ONLY_AWS_OUTPUTS=true

# Testing/local mock flag (use true to avoid live AWS calls)
USE_LOCAL_MODELS=true

# Optional fallbacks
ALLOW_SAGEMAKER_FALLBACK=false
SAGEMAKER_ENDPOINT_NAME=
AUTOML_ENDPOINT_NAME=

# Polly / Transcribe / Translate defaults
POLLY_VOICE=Joanna
TRANSCRIBE_ROLE_ARN=arn:aws:iam::123456789012:role/TranscribeAccessRole
SNS_TOPIC_ARN=

# Logging
LOG_LEVEL=INFO

# Secret credentials (prefer IAM roles in production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
