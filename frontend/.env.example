# AI Learning Assistant — Next.js Environment Variables
# Copy this file to .env.local for local dev
# For Vercel: set these in Project Settings → Environment Variables

# ─────────────────────────────────────────────────────────
# REQUIRED: Backend API URL
# In Next.js, browser-exposed env vars must be prefixed NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────
# Local development (FastAPI running on your machine):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Elastic Beanstalk deployment (replace with your EB URL):
# NEXT_PUBLIC_API_URL=http://ai-learning-env.eba-XXXXXXXX.ap-south-1.elasticbeanstalk.com

# Production custom domain:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ─────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=AI Learning Assistant
NEXT_PUBLIC_ENV=development
